<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="480.0" prefWidth="854.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.factapp.controller.MenuPrincipalController">
    <top>
        <VBox xmlns:fx="http://javafx.com/fxml/1">
            <MenuBar>
                <menus>
                    <Menu text="Archivo">
                        <items>
                            <MenuItem fx:id="mnuProductos" onAction="#abrirProductos" text="Productos" />

                            <MenuItem fx:id="mnuSalir" onAction="#salir" text="Salir" />
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <ToolBar>
                <items>
                    <Button fx:id="btnProductos" onAction="#abrirProductos">
                  <graphic>
                     <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../icons/product.png" />
                        </image>
                     </ImageView>
                  </graphic></Button>
               <Button fx:id="btnCategoria" layoutX="10.0" layoutY="10.0" onAction="#abrirProductos">
                  <graphic>
                     <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../icons/categories.png" />
                        </image>
                     </ImageView>
                  </graphic>
               </Button>
               <Button fx:id="btnCargo" layoutX="62.0" layoutY="10.0" onAction="#abrirProductos">
                  <graphic>
                     <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../icons/cargo.png" />
                        </image>
                     </ImageView>
                  </graphic>
               </Button>
               <Button fx:id="btnEmpleado" layoutX="114.0" layoutY="10.0" onAction="#abrirProductos">
                  <graphic>
                     <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../icons/empleado.png" />
                        </image>
                     </ImageView>
                  </graphic>
               </Button>
                </items>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <HBox alignment="CENTER" BorderPane.alignment="CENTER">
         <VBox alignment="CENTER" prefHeight="420.0" prefWidth="398.0">
            <children>
               <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../icons/bill.png" />
                  </image>
               </ImageView>
                  <Label text="Sistema de facturación">
                      <font>
                          <Font size="28.0" />
                      </font>
                  <padding>
                     <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                  </padding>
                  </Label>
            </children>
         </VBox>
        </HBox>
    </center>

</BorderPane>
